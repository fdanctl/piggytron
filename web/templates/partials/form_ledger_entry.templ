templ TransferForm(v views.TransferForm, categories, accounts []components.SelectOption, id string) {
	<form
		class="space-y-sm"
		hx-on:submit="event.preventDefault()"
		if id != "" {
			hx-put={ fmt.Sprintf("/partials/ledger/entry/%s", id) }
		} else {
			hx-post="/partials/ledger/entry"
		}
		hx-swap="outerHTML"
		novalidate
	>
		<input type="hidden" name="type" value="transfer"/>
		<div class="grid gap-xs" style="grid-template-columns: 1.5fr 1fr;">
			@components.InputGroup(
				"",
				"Amount",
