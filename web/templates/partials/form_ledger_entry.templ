package partials

import (
	"fmt"
	"github.com/fdanctl/piggytron/web/templates/components"
	"github.com/fdanctl/piggytron/web/views"
	"slices"
)

templ TransactionFormTabs() {
	@components.DialogHeader("", "New Entry", nil) {
		<div class="tabs-list">
			<button
				class="reset-btn tab-trigger tab-trigger--active"
				data-tab="income"
				data-action="ui.tab.change"
				data-tab-trigger="transaction"
			>
				Income
			</button>
			<button
				class="reset-btn tab-trigger"
				data-tab="expense"
				data-action="ui.tab.change"
				data-tab-trigger="transaction"
			>
				Expense
			</button>
			<button
				class="reset-btn tab-trigger"
				data-tab="transfer"
				data-action="ui.tab.change"
				data-tab-trigger="transaction"
			>
				Transfer
			</button>
			<button
				class="reset-btn tab-trigger"
				data-tab="interest"
				data-action="ui.tab.change"
				data-tab-trigger="transaction"
			>
				Interest
			</button>
		</div>
	}
}

templ TransactionFormActionBtnsTab() {
	<div class="w-full flex justify-end mt-md">
		@components.Button(
			"Confirm",
			"mt-md",
			components.BtnPrimary,
			components.BtnMedium,
			templ.Attributes{
				"onclick": "this.closest('.dialog').querySelector('.tab-content:not(.hidden) .btn[type=submit]').click()",
			},
		)
	</div>
}

templ FormActionBtns(text string) {
	<div class="w-full flex justify-end mt-md">
		@components.Button(
			text,
			"mt-md",
			components.BtnPrimary,
			components.BtnMedium,
			templ.Attributes{
				"onclick": "this.closest('.dialog').querySelector('form .btn[type=submit]').click()",
			},
		)
	</div>
}

templ TransactionForm(
	vi views.IncomeForm,
	ve views.ExpenseForm,
	vt views.TransferForm,
	vin views.InterestForm,
	incomeCategories,
	expenseCategories,
	accounts []components.SelectOption,
	accountsNoGoals []components.SelectOption,
) {
	<div class="tab-content" id="income-content" data-tab-content="transaction">
		@IncomeForm(vi, incomeCategories, accountsNoGoals, "")
	</div>
	<div class="tab-content hidden" id="expense-content" data-tab-content="transaction">
		@ExpenseForm(ve, expenseCategories, accountsNoGoals, "")
	</div>
	<div class="tab-content hidden" id="transfer-content" data-tab-content="transaction">
		@TransferForm(vt, expenseCategories, accounts, "")
	</div>
	<div class="tab-content hidden" id="interest-content" data-tab-content="transaction">
		@InterestForm(vin, incomeCategories, accounts, "")
	</div>
}

templ IncomeForm(v views.IncomeForm, categories, accounts []components.SelectOption, id string) {
	<form
		class="space-y-sm"
		hx-on:submit="event.preventDefault()"
		if id != "" {
			hx-put={ fmt.Sprintf("/partials/ledger/entry/%s", id) }
		} else {
			hx-post="/partials/ledger/entry"
		}
		hx-swap="outerHTML"
		novalidate
	>
		<input type="hidden" name="type" value="income"/>
		<div class="grid gap-xs" style="grid-template-columns: 1.5fr 1fr;">
			@components.InputGroup(
				"",
				"Amount",
				views.StringArrToStr(v.ValidateAmount()),
				v.AmountHasError(),
				true,
				templ.Attributes{
					"id":          "income-amount",
					"type":        "text",
					"name":        "amount",
					"placeholder": "420.69",
					"value":       v.Amount,
					"data-focus":  "ui.cash-input.focus",
					"data-blur":   "ui.cash-input.blur",
					"data-input":  "ui.cash-input.input",
				},
			)
			@components.SelectGroup(
				"",
				"Currency",
				v.Currency,
				"-- Select currency --",
				[]components.SelectOption{
					{
						Label: "EUR",
						Value: "EUR",
					},
				},
				views.StringArrToStr(v.ValidateCurrency()),
				v.CurrencyHasError(),
				true,
				templ.Attributes{
					"id":   "currency",
					"name": "currency",
				},
			)
		</div>
		@components.InputGroup(
			"",
			"Description",
			views.StringArrToStr(v.ValidateDescription()),
			v.DescriptionHasError(),
			true,
			templ.Attributes{
				"id":          "income-description",
				"type":        "text",
				"name":        "description",
				"placeholder": "Salary",
				"value":       v.Description,
			},
		)
		@components.DateInputGroup(
			"w-full",
			"Date",
			views.StringArrToStr(v.ValidateDate()),
			v.DateHasError(),
			true,
			templ.Attributes{
				"id":    "income-date",
				"type":  "text",
				"name":  "date",
				"value": v.Date,
			},
		)
		@components.SelectGroup(
			"",
			"Category",
			v.Category,
			"-- Select category --",
			categories,
			views.StringArrToStr(v.ValidateCategory()),
			v.CategoryHasError(),
			true,
			templ.Attributes{
				"id":   "income-category",
				"name": "category",
			},
		)
		@components.SelectGroup(
			"",
			"Destination",
			v.DestinationAcc,
			"-- Select account --",
			accounts,
			views.StringArrToStr(v.ValidateDestinationAcc()),
			v.DestinationAccHasError(),
			true,
			templ.Attributes{
				"id":   "income-destination",
				"name": "destination",
			},
		)
		@components.TextAreaGroup(
			"",
			"Note",
			views.StringArrToStr(v.ValidateNote()),
			v.NoteHasError(),
			false,
			templ.Attributes{
				"id":          "income-note",
				"rows":        "4",
				"maxlenght":   "200",
				"name":        "note",
				"placeholder": "Add a note",
				"value":       v.Note,
			},
		)
		<div class="w-full flex justify-end mt-md">
			@components.Button(
				"Confirm",
				"mt-md hidden",
				components.BtnPrimary,
				components.BtnMedium,
				templ.Attributes{
					"type": "submit",
				},
			)
		</div>
	</form>
}

