					"data-focus":  "ui.cash-input.focus",
					"data-blur":   "ui.cash-input.blur",
					"data-input":  "ui.cash-input.input",
				},
			)
			@components.SelectGroup(
				"",
				"Currency",
				v.Currency,
				"-- Select currency --",
				[]components.SelectOption{
					{
						Label: "EUR",
						Value: "EUR",
					},
				},
				views.StringArrToStr(v.ValidateCurrency()),
				v.CurrencyHasError(),
				true,
				templ.Attributes{
					"id":   "currency",
					"name": "currency",
				},
			)
		</div>
		@components.InputGroup(
			"",
			"Description",
			views.StringArrToStr(v.ValidateDescription()),
			v.DescriptionHasError(),
			true,
			templ.Attributes{
				"id":          "transfer-description",
				"type":        "text",
				"name":        "description",
				"placeholder": "Deposit",
				"value":       v.Description,
			},
		)
		@components.DateInputGroup(
			"w-full",
			"Date",
			views.StringArrToStr(v.ValidateDate()),
			v.DateHasError(),
			true,
			templ.Attributes{
				"id":    "transfer-date",
				"type":  "text",
				"name":  "date",
				"value": v.Date,
			},
		)
		{{ categories = append([]components.SelectOption{{Label: "-- Select category --", Value: ""}}, categories...) }}
		@components.SelectGroup(
			"",
			"Category",
			v.Category,
			"-- Select category --",
			categories,
			views.StringArrToStr(v.ValidateCategory()),
			v.CategoryHasError(),
			false,
			templ.Attributes{
				"id":   "transfer-category",
				"name": "category",
			},
		)
		@components.SelectGroup(
			"",
			"From",
			v.SourceAcc,
			"-- Select account --",
			accounts,
			views.StringArrToStr(v.ValidateSourceAcc()),
			v.SourceAccHasError(),
			true,
			templ.Attributes{
				"id":   "transfer-source",
				"name": "source",
			},
		)
		@components.SelectGroup(
			"",
			"To",
			v.DestinationAcc,
			"-- Select account --",
			accounts,
			views.StringArrToStr(v.ValidateDestinationAcc()),
			v.DestinationAccHasError(),
			true,
			templ.Attributes{
				"id":   "transfer-destination",
				"name": "destination",
			},
		)
		@components.TextAreaGroup(
			"",
			"Note",
			views.StringArrToStr(v.ValidateNote()),
			v.NoteHasError(),
			false,
			templ.Attributes{
				"id":          "transfer-note",
				"rows":        "4",
				"maxlenght":   "200",
				"name":        "note",
				"placeholder": "Add a note",
				"value":       v.Note,
			},
		)
		<div class="w-full flex justify-end mt-md">
			@components.Button(
				"Confirm",
				"mt-md hidden",
				components.BtnPrimary,
				components.BtnMedium,
				templ.Attributes{
					"type": "submit",
				},
			)
		</div>
	</form>
}

