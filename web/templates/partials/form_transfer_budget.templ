type BudgetSelectOption struct {
	Label     string
	Value     string
	Available int
	Type      string
	Attrs     templ.Attributes
}

templ CategoryBudgetSelect(placeholder string, value string, options []BudgetSelectOption, hasError bool, attrs templ.Attributes) {
	{{
		class := "input select"
		if hasError {
			class += " input--error"
		}
		if value != "" {
			for _, o := range options {
				if value == o.Value {
					placeholder = o.Label
				}
			}
		}
	}}
	@components.Dropdown(class, placeholder, true, templ.Attributes{
		"data-action": "ui.select.center-selected",
	},
	) {
		<ul class="options">
			for _, o := range options {
				<li
					class={ templ.KV("options__item--selected", o.Label == placeholder) }
					data-action="ui.select.option transfer-budget.overspent.max-value"
					onclick=""
					data-value={ o.Value }
					{ o.Attrs... }
				>
					<div class="flex items-center justify-between gap-sm w-full">
						<div class="flex items-center gap-sm">
							<span class="option__label">{ o.Label }</span>
							switch o.Type {
								case "needs":
									@components.Badge("text-xxs badge--sm", "Needs", components.BadgeNeeds)
								case "wants":
									@components.Badge("text-xxs badge--sm", "Wants", components.BadgeWants)
								case "savings":
									@components.Badge("text-xxs badge--sm", "Savings", components.BadgeSavings)
							}
						</div>
						<span
							class="available hidden"
						>
							{ views.FormatAmount(float64(o.Available)/100) }
						</span>
						<span
							class={ templ.KV("text-negative", o.Available < 0) }
						>
							{ views.FormatMoney(float64(o.Available)/100, currency.EUR, language.AmericanEnglish) }
						</span>
					</div>
					@components.CheckSvg(16, "", "")
				</li>
			}
		</ul>
		<input class="hidden" type="text" value={ value } { attrs... }/>
	}
}

templ CategoryBudgetSelectGroup(class, label, value, placeholder string, options []BudgetSelectOption, errMsg string, hasError, required bool, attrs templ.Attributes) {
	<div
		class={ "input-group", templ.KV("input-group--error", hasError), templ.KV(class, class != "") }
	>
		if id, ok := attrs["id"]; ok && label != "" {
			<label for={ id.(string) }>
				{ label }
				if (!required) {
					<span>(optional)</span>
				}
			</label>
		}
		@CategoryBudgetSelect(placeholder, value, options, hasError, attrs)
		<span class="input-group__message">{ errMsg }</span>
	</div>
}
