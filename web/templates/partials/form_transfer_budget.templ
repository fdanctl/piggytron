package partials

import (
	"github.com/fdanctl/piggytron/web/templates/components"
	"github.com/fdanctl/piggytron/web/views"
	"golang.org/x/text/currency"
	"golang.org/x/text/language"
)

templ TransferUnderspend(v *views.TransferBudgetForm, categories []BudgetSelectOption) {
	<form
		class="space-y-sm"
		hx-on:submit="event.preventDefault()"
		hx-post="/partials/transfer-budget"
		hx-swap="outerHTML"
		hx-include="#unassign-input"
		novalidate
	>
		<input type="hidden" name="type" value="underspend"/>
		<input type="hidden" name="month" value={ v.Month }/>
		@components.InputGroup(
			"",
			"Amount",
			views.StringArrToStr(v.ValidateAmount()),
			v.AmountHasError(),
			true,
			templ.Attributes{
				"id":          "income-amount",
				"type":        "text",
				"name":        "amount",
				"placeholder": "420.69",
				"value":       v.Amount,
				"data-focus":  "ui.cash-input.focus",
				"data-blur":   "ui.cash-input.blur",
				"data-input":  "ui.cash-input.input",
			},
		)
		<input type="hidden" name="from" value={ v.FromID }/>
		@CategoryBudgetSelectGroup(
			"",
			"To",
			v.ToID,
			"-- Select category --",
			categories,
			views.StringArrToStr(v.ValidateToID()),
			v.ToIDHasError(),
			true,
			templ.Attributes{
				"id":   "to",
				"name": "to",
			},
		)
		<div class="w-full flex justify-end mt-md">
			@components.Button(
				"Enter",
				"mt-md",
				components.BtnPrimary,
				components.BtnMedium,
				templ.Attributes{
					"type": "submit",
				},
			)
		</div>
	</form>
}

