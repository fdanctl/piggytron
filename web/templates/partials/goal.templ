package partials 

import (
	"github.com/fdanctl/piggytron/web/templates/components"
	"github.com/fdanctl/piggytron/web/views"
	"golang.org/x/text/currency"
	"golang.org/x/text/language"
)

templ GoalItem(g views.Goal, attrs templ.Attributes) {
	<li class={ "goal-card", templ.KV("goal-card--funded", g.Status == views.FundedStatus), "space-y-xs" } { attrs... }>
		<a href={ "/goals/" + g.ID }>
			<div class="flex justify-between">
				<h5>
					{ g.Name }
				</h5>
				if g.Status == views.CompletedStatus {
					@components.Badge("capitalize", string(g.Status), components.BadgeChecking)
				}
				if g.Status == views.CancelledStatus {
					@components.Badge("capitalize", string(g.Status), components.BadgeClosed)
				}
			</div>
			<div class="mb-xs">
				<div class="flex justify-between items-end">
					<p class="goal-card__amount">
						{ views.FormatMoney(float64(g.Amount)/100, currency.EUR, language.AmericanEnglish) } <sub>/{ views.FormatMoney(float64(g.TargetAmount)/100,currency.EUR, language.AmericanEnglish) }</sub>
					</p>
					<p class="goal-card__percentage">
						{ views.FormatFloat(g.CompletePercentage) }%
					</p>
				</div>
				@components.ProgressBar("progress-bar--xs", g.CompletePercentage)
			</div>
			<div class="goal-card__subinfo">
				<div>
					<span>Monthly Needed</span>
					<span>{ g.MonthlyNeeded }</span>
				</div>
				<div>
					<span>Months Left</span>
					<span>{ g.MonthsLeft }</span>
				</div>
			</div>
		</a>
	</li>
}
