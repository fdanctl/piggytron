package partials

import (
	"github.com/fdanctl/piggytron/internal/query"
	"github.com/fdanctl/piggytron/web/templates/components"
)

templ CategoryItem(cat query.CategoryDTO, attrs templ.Attributes) {
	<li { attrs... } class={ "category-item", templ.KV("category-item--archived", cat.Status == "archived") }>
		<a class="flex justify-between items-center" href={ "/categories/" + cat.ID }>
			<div>
				{ cat.Name }
			</div>
			<div class="space-x-xs">
				if cat.Status == "archived" {
					@components.Badge("", "Archived", components.BadgeClosed)
				}
				switch cat.Type {
					case "needs":
						@components.Badge("", "Needs", components.BadgeNeeds)
					case "wants":
						@components.Badge("", "Wants", components.BadgeWants)
					case "savings":
						@components.Badge("", "Savings", components.BadgeSavings)
				}
			</div>
		</a>
	</li>
}
