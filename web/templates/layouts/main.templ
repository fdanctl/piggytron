package layouts

import "github.com/fdanctl/piggytron/web/templates/components"

templ Main() {
	@components.Sidebar()
	@components.Header()
	<main
		class="main"
		tabindex="-1"
		hx-history-elt
	>
		<div id="content">
			{ children... }
		</div>
	</main>
	<div
		id="dialog-root"
		data-action="ui.overlay.close"
		data-keydown="ui.overlay.close"
	>
		<div
			class="dialog__overlay hidden"
			tabindex="-1"
			data-pointerdown="ui.dialog.start-drag"
		>
			<div
				id="nav-sheet"
				class="dialog"
			>
				<div class="dialog__bar">
					<div></div>
				</div>
				@components.Nav(templ.Attributes{
					"hx-swap": "innerHTML show:window:top",
				})
			</div>
		</div>
	</div>
}
