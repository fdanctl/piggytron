package components

templ Logo() {
	<div class="logo unselectable">
		<img src="/static/assets/logos/logoAsset2.svg" width="32px"/>
		<h1>Piggytron</h1>
	</div>
}

templ Notification() {
	<div class="notification">
		<p>9+</p>
	</div>
}

templ Avatar(src string) {
	if src != "" {
		<div class="flex justify-center items-center">
			<img
				class="rounded-full object-cover"
				style="width: 32px; height: 32px;"
				src={ src }
				alt="Rounded avatar"
			/>
		</div>
	} else {
		<span class="avatar">
			@UserSvg(0, "", "")
		</span>
	}
}

templ ProfilePic(showNotification bool) {
	<div class="pfp">
		@Avatar("")
		if showNotification {
			@Notification()
		}
	</div>
}

templ Header() {
	<header class="header">
		@Logo()
		<div>
			<div class="relative flex items-center justify-center">
				@BellSvg(0, "", "")
				@Notification()
			</div>
			@ProfilePic(false)
			<button
				class="reset-btn flex justify-center items-center cursor-pointer"
				data-action="ui.nav-sheet.open"
			>
				@MenuSvg(0, "", "")
			</button>
		</div>
	</header>
}
