package components

import "fmt"

type navLink struct {
	name string
	href string
	icon templ.Component
	sub  []navLink
}

var NavLinks = [3][]navLink{
	{
		{"Dashboard", "/", HouseSvg(0, "", ""), nil},
		{"Budget", "/budget", ChartPieSvg(0, "", ""), nil},
	},
	{
		{"Goals", "/goals", PiggyBankSvg(0, "", ""), nil},
		{"Banks", "/banks", LandmarkSvg(0, "", ""), nil},
		{"Ledger", "/ledger", NotebookSvg(0, "", ""), nil},
	},
	{
		{"Categories", "/categories", TagSvg(0, "", ""), nil},
		{"Reports", "", FileChartColumnSvg(0, "", ""), []navLink{
			{"Expenses", "/reports/expenses", nil, nil},
			{"Income", "/reports/income", nil, nil},
		}},
	},
}

templ Nav(attrs templ.Attributes) {
	<nav
		class="nav"
		hx-target="#content"
		hx-boost="true"
		data-afterrequest="ui.nav.navigate"
		{ attrs... }
	>
		<ul class="unselectable">
			for i, groups := range NavLinks {
				for _, v := range groups {
					@navLi(v)
				}
				if i < len(NavLinks) - 1 {
					<hr/>
				}
			}
		</ul>
	</nav>
}

templ navLi(v navLink) {
	<li
		style={ setAnchorName(v.name) }
	>
		<a
			data-name={ v.name }
			onkeydown="event.key === 'Enter' && event.target.click()"
			data-mouseover="ui.sidebar.show-popover"
			data-mouseout="ui.sidebar.hide-popover"
			data-focus="ui.sidebar.show-popover"
			data-blur="ui.sidebar.hide-popover"
			if v.href != "" {
				data-action="ui.nav.collapse-all-sublinks"
				href={ v.href }
			} else {
				data-action="ui.nav.toggle-sublinks"
			}
		>
			<i class="flex justify-center">
				@v.icon
			</i>
			<span>{ v.name }</span>
			if len(v.sub) > 0 {
				<i class="li-chevron">
					@ChevronLeftSvg(16, "", "")
				</i>
			}
		</a>
		if len(v.sub) > 0 {
			<div id={ fmt.Sprintf("%s-sublinks", v.name) } class="sublinks">
				<ul>
					for i, s := range v.sub {
						<li>
							<a
								data-name={ v.name }
								href={ s.href }
								data-focus="ui.nav.sublinks-focus ui.nav.expand-sublinks ui.sidebar.show-popover"
								if len(v.sub) - 1 == i {
									data-blur="ui.nav.collapse-sublinks ui.sidebar.hide-popover"
								}
							>
								@ChevronRightSvg(16, "", "")
								<span>
									{ s.name }
								</span>
							</a>
						</li>
					}
				</ul>
			</div>
		}
	</li>
}
