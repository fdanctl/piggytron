package pages

import (
	"fmt"
	"github.com/fdanctl/piggytron/internal/domain/budget"
	"github.com/fdanctl/piggytron/web/templates/components"
	"github.com/fdanctl/piggytron/web/views"
	"golang.org/x/text/currency"
	"golang.org/x/text/language"
	"math"
	"time"
)

templ Budget(bview views.BreadcrumbsView, datePillSince time.Time, view views.BudgetPageView) {
	<div class="flex justify-between">
		@components.Breadcrumbs(bview)
		@components.MonthPill("", view.Month.Label(), datePillSince)
	</div>
	if view.TotalBudgeted == 0 {
		@lastMonthImport(view.Month)
	}
	@BudgetStats(view.TotalBudgeted, view.ReadyToAssign, view.Income, view.UnassignCarryover, view.AvailableToSpend, view.Overspent, nil)
	<div
		id="budget-sankey"
		class="chart-container mt-xl mb-xl"
		hx-get={ fmt.Sprintf("/partials/charts/budget-chart/%s?unassign=%d", view.Month, view.UnassignCarryover) }
		hx-trigger="load"
	>
		@components.Loader("htmx-indicator h-full", nil)
	</div>
	<div class="budget-table-container">
		@budgetTable("needs", view.NeedsBudget, view.NeedsLeft, view.NeedsPct, view.NeedsRows)
		@budgetTable("wants", view.WantsBudget, view.WantsLeft, view.WantsPct, view.WantsRows)
		@budgetTable("savings", view.SavingsBudget, view.SavingsLeft, view.SavingsPct, view.SavingsRows)
	</div>
}

templ lastMonthImport(month budget.Month) {
	<div class="last-month-import w-fit mb-lg">
		<div class="last-month-import__icon">
			@components.CalendarArrowUp(0, "", "")
		</div>
		<div>
			<p class="last-month-import__h">Import { time.Date(month.Time().Year(), month.Time().Month()-1, 1, 0, 0, 0, 0, time.UTC).Month() }'s budget</p>
			<p class="last-month-import__p">Copy last month's category amounts as a starting point</p>
		</div>
		<div class="last-month-import__btns">
			@components.Button("Dismiss", "last-month-import__dismiss", components.BtnSecondary, components.BtnMedium, templ.Attributes{"data-action": "ui.element.remove", "data-target": "closest .last-month-import"})
			@components.ButtonWithIcon("Import", "", components.BtnSecondary, components.BtnMedium, templ.Attributes{"hx-post": fmt.Sprintf("/partials/budget/import?month=%s", month.String()), "hx-target": "closest .last-month-import", "hx-swap": "delete"}, components.IconLeft, components.DownloadSvg(0, "", ""))
		</div>
	</div>
}

templ BudgetStats(totalBudgeted, leftToBudget, income, unassignCarryover, leftToSpend, overspent int, attrs templ.Attributes) {
	<div id="budget-stats" class="budget-stats" { attrs... }>
		<div class="card">
			<h6 class="card__title mb-sm">Ready to assign</h6>
			<p class={ "metric__value metric__value--xl", templ.KV("text-negative", leftToBudget < 0) }>
				{ views.FormatMoney(float64(leftToBudget) / 100, currency.EUR, language.AmericanEnglish) }
				<input id="ltb-input" type="hidden" name="ltb" value={ leftToBudget }/>
				<input id="total-budgeted" type="hidden" name="total-budgeted" value={ totalBudgeted }/>
			</p>
			<p class="metric__sub mt-xs">
				of { views.FormatMoney(float64(income) / 100, currency.EUR, language.AmericanEnglish) } income 
				if unassignCarryover > 0 {
					+ {  views.FormatMoney(float64(unassignCarryover) / 100, currency.EUR, language.AmericanEnglish) } unassign
				}
				<input id="income-input" type="hidden" name="income" value={ income }/>
				<input id="unassign-input" type="hidden" name="unassign" value={ unassignCarryover }/>
			</p>
		</div>
		<div class="card">
			<h6 class="card__title mb-sm">Available to spend</h6>
			<p id="left-to-spent" class={ "metric__value metric__value--xl", templ.KV("text-negative", leftToSpend < 0) }>
				{ views.FormatMoney(float64(leftToSpend) / 100, currency.EUR, language.AmericanEnglish) }
				<input id="lts-input" type="hidden" name="lts" value={ leftToSpend }/>
			</p>
			<p class="metric__sub mt-xs">
				budgeted but unspent
			</p>
		</div>
		<div class="card">
			<h6 class="card__title mb-sm">Overspent</h6>
			<p class={ "metric__value metric__value--xl", templ.KV("text-negative", overspent != 0) }>
				{ views.FormatMoney(float64(overspent) / 100, currency.EUR, language.AmericanEnglish) }
			</p>
			<p class="metric__sub mt-xs">
				across all categories
				<input id="overspent" type="hidden" name="overspent" value={ overspent }/>
			</p>
		</div>
	</div>
}

templ budgetTable(eType string, totalBudget, totalLeft int, pct float64, rows []views.BudgetRowView) {
	<div
		class={ "budget-table", fmt.Sprintf("budget-table--%s", string(eType)) }
		hx-include="inherit, find [name='total-row-left'], find [name='ctype']"
	>
		<input type="hidden" name="ctype" value={ eType }/>
		<div class="budget-table__head">
			<span class="capitalize">{ string(eType) } <span id={ fmt.Sprintf("%s-pct", eType) } class="font-mono text-xs font-normal">({ views.FormatFloat(pct) }%)</span></span>
			<span>Budget</span>
			<span>Available</span>
		</div>
		for _, c := range rows {
			<div class="budget-table__row" hx-include="inherit, find [name='cat-left']">
				<div class="flex gap-xs items-center">
					<span>{ c.Name }</span>
					if c.Carryover != 0 {
						@Carryover(c.CategoryID, eType, c.Carryover)
					}
				</div>
				<div class="flex items-center gap-xs">
					€
					@components.Input(
						"",
						false,
						templ.Attributes{
							"type":               "text",
							"name":               "amount",
							"value":              views.FormatAmount(float64(c.Budgeted) / 100),
							"data-keydown":       "ui.budget-input.keydown",
							"data-focus":         "ui.cash-input.focus",
							"data-blur":          "ui.cash-input.blur",
							"data-input":         "ui.cash-input.input",
							"data-beforerequest": "ui.budget-input.animate",
							"hx-target":          "next .budget-info",
							"hx-swap":            "outerHTML",
							"hx-post":            "/partials/budget",
							"hx-trigger":         "input changed delay:500ms, keyup[key=='Enter']",
							"hx-include":         "inherit, #needs-total-row-budget, #wants-total-row-budget, #savings-total-row-budget, #total-budgeted, #ltb-input, #income-input, #unassign-input, #lts-input, #overspent, next [name='prev-amount'], next [name='month'], next [name='cid']",
						})
					@BudgetInfoInputs(c.Budgeted, c.Month.String(), c.CategoryID)
				</div>
				@CatRowLeftCell(c.CategoryID, c.Available, nil)
			</div>
		}
		@TotalRow(eType, totalBudget, totalLeft, nil)
	</div>
}

templ Carryover(id string, etype string, value int) {
	{{
		vstring := views.FormatMoney(float64(value)/100, currency.EUR, language.AmericanEnglish)
		var tooltipMsg string
		posneg := "positive"
		if value < 0 {
			posneg = "negative"
			tooltipMsg = fmt.Sprintf("%s overspent last month", vstring)
		} else {
			vstring = "+" + vstring
			tooltipMsg = fmt.Sprintf("%s not spent last month", vstring)
		}
	}}
	<span
		class={ "budget-carryover", fmt.Sprint("budget-carryover--", etype), fmt.Sprint("budget-carryover--", posneg) }
		style={ fmt.Sprintf("anchor-name: --%s;", id) }
		data-name={ id }
		data-delay="500"
		data-mouseover="ui.popover.show"
		data-mouseout="ui.popover.hide"
	>
		<span>{ vstring }</span>
		<i>
			@components.RotateCcwSvg(10, "", "")
		</i>
		@components.Tooltip("", tooltipMsg, id, components.TopLeft, nil)
	</span>
}

templ CatRowLeftCell(catID string, left int, attrs templ.Attributes) {
	<span id={ catID } class={ templ.KV("text-negative", left < 0) } { attrs... }>
		{ views.FormatMoney(float64(left) / 100, currency.EUR, language.AmericanEnglish) }
		<input type="hidden" name="cat-left" value={ left }/>
	</span>
}

templ TotalRow(eType string, totalBudget, totalLeft int, attrs templ.Attributes) {
	<div id={ fmt.Sprintf("%s-total-row", eType) } class="budget-table__total-row" { attrs... }>
		<span>Total</span>
		<span>
			<input id={ fmt.Sprint(eType, "-total-row-budget") } type="hidden" name={ fmt.Sprint(eType, "-total-row-budget") } value={ totalBudget }/>
			{ views.FormatMoney(float64(totalBudget) / 100, currency.EUR, language.AmericanEnglish) }
		</span>
		<span class={ templ.KV("text-negative", totalLeft < 0) }>
			<input type="hidden" name="total-row-left" value={ totalLeft }/>
			{ views.FormatMoney(float64(totalLeft) / 100, currency.EUR, language.AmericanEnglish) }
		</span>
	</div>
}

templ BudgetInfoInputs(amount int, month string, cid string) {
	<div class="budget-info hidden">
		<input type="hidden" name="prev-amount" value={ amount }/>
		<input type="hidden" name="month" value={ month }/>
		<input type="hidden" name="cid" value={ cid }/>
	</div>
}

templ PctSpan(catType string, totalRowBudget, totalBudgeted int) {
	<span id={ fmt.Sprintf("%s-pct", catType) } hx-swap-oob="outerHTML" class="font-mono text-xs font-normal">
		{{
			pct := (float64(totalRowBudget) / float64(totalBudgeted)) * 100
			if math.IsNaN(pct) {
				pct = 0
			}
		}}
		({ views.FormatFloat(pct) }%)
	</span>
}
