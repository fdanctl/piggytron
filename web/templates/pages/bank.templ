package pages

import (
	"fmt"
	"github.com/fdanctl/piggytron/internal/domain/account"
	"github.com/fdanctl/piggytron/internal/query"
	"github.com/fdanctl/piggytron/web/templates/components"
	"github.com/fdanctl/piggytron/web/templates/partials"
	"github.com/fdanctl/piggytron/web/views"
	"golang.org/x/text/currency"
	"golang.org/x/text/language"
	"time"
)

templ Bank(bview views.BreadcrumbsView, b query.AccountWithSum, tt []views.Transaction, hasMore bool, ttCount int) {
	<div class="flex justify-between">
		@components.Breadcrumbs(bview)
		@components.IconDropdown("", components.EllipsisSvg(0, "", ""), true, nil) {
			<ul class="breadcrumbs-selection">
				<li>
					<button
						class="reset-btn"
						data-action="ui.popover.hide"
						hx-get={ fmt.Sprintf("/partials/bank/%s/change-name", b.ID) }
						hx-target="#dialog-root"
						hx-swap="beforeend"
					>Change name</button>
				</li>
				if b.Status == "active" {
					<li>
						<button
							hx-trigger="confirmed"
							hx-post={ fmt.Sprintf("/partials/bank/%s/close", b.ID) }
							class="reset-btn"
							data-action="ui.popover.hide account.close.confirm"
							data-balance={ b.Sum }
						>Close account</button>
					</li>
				}
				<li>
					<button
						hx-trigger="confirmed"
						hx-delete={ fmt.Sprintf("/partials/bank/%s", b.ID) }
						class="reset-btn"
						data-action="ui.popover.hide account.delete.confirm"
						data-transactions={ ttCount }
					>Delete account</button>
				</li>
			</ul>
		}
	</div>
	<div>
		<div class="text-muted mb-sm uppercase text-sm flex gap-sm items-center">
			if b.Status == "closed" {
				<span>Final balance</span>
				@components.BadgeWithIcon("", "Closed", components.BadgeClosed, components.LockKeyholeSvg(10, "", ""))
			} else {
				<span>Current balance</span>
				switch b.Type {
					case string(account.CheckingType):
						@components.Badge("", b.Type, components.BadgeChecking)
					case string(account.SavingsType):
						@components.Badge("", b.Type, components.BadgeSavings)
				}
			}
		</div>
		<div class="bank-balance">
			<h2 class={ templ.KV("text-muted", b.Status == "closed") }>
				{{
					curr, err := currency.ParseISO(b.Currency)
					if err != nil {
						curr = currency.EUR
					}
				}}
				{ views.FormatMoney(float64(b.Sum)/100, curr, language.AmericanEnglish) }
				<span class="text-muted text-base uppercase">{ b.Currency }</span>
			</h2>
			<div class="flex gap-xs">
				@components.Button(
					"Add money",
					"",
					components.BtnOutline,
					components.BtnMedium,
					templ.Attributes{
						"hx-get":    fmt.Sprintf("/partials/ledger/entry?preset=transfer&destination=%s", b.ID),
						"hx-target": "#dialog-root",
						"hx-swap":   "beforeend",
						"disabled":  b.Status == "closed",
					},
				)
				@components.Button(
					"Send money",
					"",
					components.BtnOutline,
					components.BtnMedium,
					templ.Attributes{
						"hx-get":    fmt.Sprintf("/partials/ledger/entry?preset=transfer&source=%s", b.ID),
						"hx-target": "#dialog-root",
						"hx-swap":   "beforeend",
						"disabled":  b.Status == "closed",
					},
				)
			</div>
		</div>
	</div>
	if b.Status == "closed" {
		@closeNotice("mt-md", *b.ClosedAt)
	}
	{{
		query := ""
		if b.Status == "closed" {
			query = fmt.Sprintf("closedAt=%s", views.FormatDateOnly(*b.ClosedAt))
		}
	}}
	<div
		id="bank-chart-card"
		class={ "card relative mt-xl", templ.KV("card--muted", b.Status == "closed") }
		hx-get={ fmt.Sprintf("/partials/charts/bank-hist/%s?%s", b.ID, query) }
		hx-trigger="load"
	>
		<div
			class="chart-container"
			style="margin-top: calc(-1 * var(--spacing-md));"
		>
			@components.Loader("htmx-indicator h-full", nil)
		</div>
		<div class="bank-chart__legend invisible">
			24 transactions
		</div>
	</div>
	<div class="mt-lg" id="bank-transactions">
		<div class="flex justify-between">
			<h4 class="card__title">Transactions</h4>
			<div class="flex items-start gap-xs">
				<span class="text-muted text-xs">
					{ ttCount } movements
				</span>
				<a
					class="text-xs"
					href={ fmt.Sprintf("/ledger?accounts=%s", b.ID) }
				>
					view all
				</a>
			</div>
		</div>
		@partials.TransactionsList(tt, fmt.Sprintf("page=2&accounts=%s", b.ID), hasMore)
	</div>
}

templ closeNotice(class string, closedAt time.Time) {
	<div class={ "closed-notice", templ.KV(class, class != "") }>
		@components.CalendarX2(0, "", "closed-notice__icon")
		<div class="closed-notice-text">
			<strong class="text-sm">This account was closed on { views.FormatDate(closedAt) }</strong>
			<p class="text-sm text-muted">Transaction history is available for reference. No new transactions can be made.</p>
		</div>
	</div>
}
