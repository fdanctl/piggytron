	<!-- ============================================================ -->
	<!-- TOAST (via OOB swap injection for testing)                     -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Toast Notifications
		</h2>
		<p class="text-sm text-muted mb-sm">Toasts are rendered via OOB swap. The following are shown inline for preview purposes.</p>
		<div class="flex flex-col gap-sm" style="max-width: 400px;">
			<div class="toast toast--success">
				@components.CheckSvg(16, "", "")
				<div><p>Success! Operation completed.</p></div>
			</div>
			<div class="toast toast--warning">
				@components.TriangleAlertSvg(16, "", "")
				<div><p>Warning: Please review your input.</p></div>
			</div>
			<div class="toast toast--error">
				@components.CircleXSvg(16, "", "")
				<div><p>Error: Something went wrong.</p></div>
			</div>
			<div class="toast toast--info">
				@components.InfoSvg(16, "", "")
				<div><p>Info: New update available.</p></div>
			</div>
		</div>
	</section>
}
