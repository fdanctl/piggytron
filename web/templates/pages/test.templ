package pages

import (
	"github.com/fdanctl/piggytron/web/templates/components"
	"github.com/fdanctl/piggytron/web/views"
	"time"
)

templ justTxt(txt string) {
	<p>{ txt }</p>
}

templ mockCardContent(title string) {
	<div
		class="chart-container"
	>
		@components.Loader("h-full", nil)
	</div>
}

templ Test() {
	<h1 class="text-2xl font-bold mb-lg">Component & Icon Test Page</h1>
	<!-- ============================================================ -->
	<!-- Carousels                                                   -->
	<!-- ============================================================ -->
	<section>
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Carousels
		</h2>
		<div class="flex items-end gap-md mb-md">
			@components.Carousel(
				"card",
				[]templ.Component{mockCardContent("item 1"), mockCardContent("item 2"), mockCardContent("item 3")},
				true,
				true,
				false,
				nil,
			)
			@components.CarouselCard(
				"",
				"Titulo",
				[]templ.Component{mockCardContent("item 1"), mockCardContent("item 2"), mockCardContent("item 3")},
				true,
				true,
				true,
				nil,
			)
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- BUTTONS                                                        -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Buttons
		</h2>
		<h3 class="font-medium mb-sm">Variants — Enabled vs Disabled</h3>
		<div class="flex flex-wrap gap-sm items-center mb-md">
			@components.Button("Primary", "", components.BtnPrimary, components.BtnMedium, nil)
			@components.Button("Primary", "", components.BtnPrimary, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.Button("Secondary", "", components.BtnSecondary, components.BtnMedium, nil)
			@components.Button("Secondary", "", components.BtnSecondary, components.BtnMedium, templ.Attributes{"disabled": ""})
		</div>
		<div class="flex flex-wrap gap-sm items-center mb-md">
			@components.Button("Outline Primary", "", components.BtnOutlinePrimary, components.BtnMedium, nil)
			@components.Button("Outline Primary", "", components.BtnOutlinePrimary, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.Button("Outline", "", components.BtnOutline, components.BtnMedium, nil)
			@components.Button("Outline", "", components.BtnOutline, components.BtnMedium, templ.Attributes{"disabled": ""})
		</div>
		<div class="flex flex-wrap gap-sm items-center mb-md">
			@components.Button("Ghost", "", components.BtnGhost, components.BtnMedium, nil)
			@components.Button("Ghost", "", components.BtnGhost, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.Button("Destructive", "", components.BtnDestructive, components.BtnMedium, nil)
			@components.Button("Destructive", "", components.BtnDestructive, components.BtnMedium, templ.Attributes{"disabled": ""})
		</div>
		<h3 class="font-medium mb-sm">Sizes — Enabled vs Disabled</h3>
		<div class="flex flex-wrap gap-sm items-center mb-md">
			@components.Button("Small", "", components.BtnPrimary, components.BtnSmall, nil)
			@components.Button("Small", "", components.BtnPrimary, components.BtnSmall, templ.Attributes{"disabled": ""})
			@components.Button("Medium", "", components.BtnPrimary, components.BtnMedium, nil)
			@components.Button("Medium", "", components.BtnPrimary, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.Button("Large", "", components.BtnPrimary, components.BtnLarge, nil)
			@components.Button("Large", "", components.BtnPrimary, components.BtnLarge, templ.Attributes{"disabled": ""})
		</div>
		<h3 class="font-medium mb-sm">Icon Buttons — Enabled vs Disabled</h3>
		<div class="flex flex-wrap gap-sm items-center mb-md">
			@components.IconButton(components.PlusSvg(0, "", ""), "", components.BtnPrimary, components.BtnMedium, nil)
			@components.IconButton(components.PlusSvg(0, "", ""), "", components.BtnPrimary, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.IconButton(components.PencilSvg(0, "", ""), "", components.BtnSecondary, components.BtnMedium, nil)
			@components.IconButton(components.PencilSvg(0, "", ""), "", components.BtnSecondary, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.IconButton(components.TrashSvg(0, "", ""), "", components.BtnDestructive, components.BtnMedium, nil)
			@components.IconButton(components.TrashSvg(0, "", ""), "", components.BtnDestructive, components.BtnMedium, templ.Attributes{"disabled": ""})
		</div>
		<div class="flex flex-wrap gap-sm items-center mb-md">
			@components.IconButton(components.SearchSvg(0, "", ""), "", components.BtnOutline, components.BtnMedium, nil)
			@components.IconButton(components.SearchSvg(0, "", ""), "", components.BtnOutline, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.IconButton(components.Settings2Svg(0, "", ""), "", components.BtnGhost, components.BtnMedium, nil)
			@components.IconButton(components.Settings2Svg(0, "", ""), "", components.BtnGhost, components.BtnMedium, templ.Attributes{"disabled": ""})
			@components.IconButton(components.EllipsisSvg(0, "", ""), "", components.BtnOutlinePrimary, components.BtnMedium, nil)
			@components.IconButton(components.EllipsisSvg(0, "", ""), "", components.BtnOutlinePrimary, components.BtnMedium, templ.Attributes{"disabled": ""})
		</div>
		<h3 class="font-medium mb-sm">Buttons with Icons — Enabled vs Disabled</h3>
		<div class="flex flex-wrap gap-sm items-center">
			@components.ButtonWithIcon("Add New", "", components.BtnPrimary, components.BtnMedium, nil, components.IconLeft, components.PlusSvg(0, "", ""))
			@components.ButtonWithIcon("Add New", "", components.BtnPrimary, components.BtnMedium, templ.Attributes{"disabled": ""}, components.IconLeft, components.PlusSvg(0, "", ""))
			@components.ButtonWithIcon("Edit", "", components.BtnSecondary, components.BtnMedium, nil, components.IconLeft, components.PencilSvg(0, "", ""))
			@components.ButtonWithIcon("Edit", "", components.BtnSecondary, components.BtnMedium, templ.Attributes{"disabled": ""}, components.IconLeft, components.PencilSvg(0, "", ""))
			@components.ButtonWithIcon("Delete", "", components.BtnDestructive, components.BtnMedium, nil, components.IconLeft, components.TrashSvg(0, "", ""))
			@components.ButtonWithIcon("Delete", "", components.BtnDestructive, components.BtnMedium, templ.Attributes{"disabled": ""}, components.IconLeft, components.TrashSvg(0, "", ""))
		</div>
		<div class="flex flex-wrap gap-sm items-center mt-sm">
			@components.ButtonWithIcon("Download", "", components.BtnOutlinePrimary, components.BtnMedium, nil, components.IconLeft, components.DownloadSvg(0, "", ""))
			@components.ButtonWithIcon("Download", "", components.BtnOutlinePrimary, components.BtnMedium, templ.Attributes{"disabled": ""}, components.IconLeft, components.DownloadSvg(0, "", ""))
			@components.ButtonWithIcon("Next →", "", components.BtnPrimary, components.BtnMedium, nil, components.IconRigth, components.ChevronRightSvg(0, "", ""))
			@components.ButtonWithIcon("Next →", "", components.BtnPrimary, components.BtnMedium, templ.Attributes{"disabled": ""}, components.IconRigth, components.ChevronRightSvg(0, "", ""))
			@components.ButtonWithIcon("Save", "", components.BtnOutline, components.BtnMedium, nil, components.IconLeft, components.CheckSvg(0, "", ""))
			@components.ButtonWithIcon("Save", "", components.BtnOutline, components.BtnMedium, templ.Attributes{"disabled": ""}, components.IconLeft, components.CheckSvg(0, "", ""))
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- BADGES                                                         -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Badges
		</h2>
		<div class="flex flex-wrap gap-sm items-center">
			@components.Badge("", "Needs", components.BadgeNeeds)
			@components.Badge("", "Wants", components.BadgeWants)
			@components.Badge("", "Savings", components.BadgeSavings)
			@components.Badge("", "Checking", components.BadgeChecking)
			@components.BadgeWithIcon("", "Closed", components.BadgeClosed, components.LockKeyholeSvg(10, "", ""))
			@components.Badge("", "Default", components.BadgeDefault)
			@components.Badge("font-mono text-xs", "Custom", components.BadgeDefault)
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- INPUTS                                                         -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Inputs
		</h2>
		<h3 class="font-medium mb-sm">Basic Input — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.Input("", false, templ.Attributes{"placeholder": "Normal input...", "type": "text", "id": "basic-input"})
			</div>
			<div style="flex: 1;">
				@components.Input("", false, templ.Attributes{"placeholder": "Disabled input...", "type": "text", "id": "basic-input-disabled", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Input with Error — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.Input("", true, templ.Attributes{"placeholder": "Error state", "type": "text", "id": "error-input"})
			</div>
			<div style="flex: 1;">
				@components.Input("", true, templ.Attributes{"placeholder": "Disabled error", "type": "text", "id": "error-input-disabled", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Password Input — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.Input("", false, templ.Attributes{"placeholder": "Enter password...", "type": "password", "id": "pwd-input"})
			</div>
			<div style="flex: 1;">
				@components.Input("", false, templ.Attributes{"placeholder": "Disabled password...", "type": "password", "id": "pwd-input-disabled", "disabled": "", "value": "password"})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Input Group — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.InputGroup("", "Username", "", false, true, templ.Attributes{"id": "inputgroup-username", "placeholder": "Enter your username"})
			</div>
			<div style="flex: 1;">
				@components.InputGroup("", "Username", "", false, true, templ.Attributes{"id": "inputgroup-username-disabled", "placeholder": "Disabled field", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Input Group (optional) — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.InputGroup("", "Nickname", "", false, false, templ.Attributes{"id": "inputgroup-nickname", "placeholder": "Enter a nickname"})
			</div>
			<div style="flex: 1;">
				@components.InputGroup("", "Nickname", "", false, false, templ.Attributes{"id": "inputgroup-nickname-disabled", "placeholder": "Disabled optional", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Input Group with Error — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.InputGroup("", "Email", "Invalid email address", true, true, templ.Attributes{"id": "inputgroup-email", "placeholder": "Enter your email"})
			</div>
			<div style="flex: 1;">
				@components.InputGroup("", "Email", "Invalid email address", true, true, templ.Attributes{"id": "inputgroup-email-disabled", "placeholder": "Disabled with error", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Search Bar — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.SearchBar("", nil)
			</div>
			<div style="flex: 1;">
				@components.SearchBar("", templ.Attributes{"placeholder": "Disabled search...", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Checkbox — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				<div class="flex flex-col gap-xs">
					@components.Checkbox("", "Accept terms and conditions", false, nil)
					@components.Checkbox("", "Remember me", true, nil)
				</div>
			</div>
			<div style="flex: 1;">
				<div class="flex flex-col gap-xs">
					@components.Checkbox("", "Disabled unchecked", false, templ.Attributes{"disabled": ""})
					@components.Checkbox("", "Disabled checked", true, templ.Attributes{"disabled": ""})
				</div>
			</div>
		</div>
		<h3 class="font-medium mb-sm">Checkbox Pill</h3>
		<div class="flex flex-wrap gap-sm">
			@components.CheckBoxPill("Option A", templ.Attributes{"name": "pill-a"})
			@components.CheckBoxPill("Option B", templ.Attributes{"name": "pill-b"})
			@components.CheckBoxPill("Option C", templ.Attributes{"name": "pill-c"})
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- SELECT & DROPDOWN                                              -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Select & Dropdown
		</h2>
		<div class="grid grid-cols-2 gap-md">
			<div>
				<h3 class="font-medium mb-sm">Select</h3>
				@components.Select("Choose an option...", "", []components.SelectOption{
					{Label: "Option 1", Value: "1"},
					{Label: "Option 2", Value: "2"},
					{Label: "Option 3", Value: "3"},
				}, false, templ.Attributes{"name": "basic-select"})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Select (preselected)</h3>
				@components.Select("Choose...", "2", []components.SelectOption{
					{Label: "Option 1", Value: "1"},
					{Label: "Option 2", Value: "2"},
					{Label: "Option 3", Value: "3"},
				}, false, templ.Attributes{"name": "preselected-select"})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Select Group</h3>
				@components.SelectGroup("", "Category", "", "Pick a category...", []components.SelectOption{
					{Label: "Food & Dining", Value: "food"},
					{Label: "Transportation", Value: "transport"},
					{Label: "Entertainment", Value: "entertainment"},
					{Label: "Utilities", Value: "utilities"},
				}, "", false, true, templ.Attributes{"id": "category-select"})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Select Group with Error</h3>
				@components.SelectGroup("", "Currency", "", "Select currency", []components.SelectOption{
					{Label: "USD", Value: "usd"},
					{Label: "EUR", Value: "eur"},
					{Label: "GBP", Value: "gbp"},
				}, "This field is required", true, true, templ.Attributes{"id": "currency-select"})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Select Group with empty option</h3>
				@components.Select("Choose an option...", "", []components.SelectOption{
					{Label: "Choose an option...", Value: ""},
					{Label: "Option 1", Value: "1"},
					{Label: "Option 2", Value: "2"},
					{Label: "Option 3", Value: "3"},
				}, false, templ.Attributes{"name": "basic-select"})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Select Group Disabled</h3>
				@components.Select("Choose an option...", "", []components.SelectOption{
					{Label: "Choose an option...", Value: ""},
					{Label: "Option 1", Value: "1"},
					{Label: "Option 2", Value: "2"},
					{Label: "Option 3", Value: "3"},
				}, false, templ.Attributes{"name": "basic-select", "disabled": ""})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Basic Dropdown</h3>
				@components.Dropdown("", "Actions ▾", false, nil) {
					<ul class="options">
						<li><span>View Details</span></li>
						<li><span>Edit</span></li>
						<li><span>Duplicate</span></li>
						<li><span>Delete</span></li>
					</ul>
				}
			</div>
			<div>
				<h3 class="font-medium mb-sm">Dropdown with min-w-full</h3>
				@components.Dropdown("", "More options ▾", true, nil) {
					<ul class="options">
						<li><span>Profile Settings</span></li>
						<li><span>Account Settings</span></li>
						<li><span>Notifications</span></li>
						<li><span>Help Center</span></li>
					</ul>
				}
			</div>
			<div></div>
			<h3 class="font-medium mb-sm">Select Pill</h3>
			@components.SelectPill("text-xs", "YTD", "ytd", components.SelectPillRight, []components.SelectOption{
				{Label: "YTD", Value: "ytd"},
				{Label: "6M", Value: "6m"},
				{Label: "1Y", Value: "1y"},
				{Label: "All", Value: "all"},
			}, templ.Attributes{"name": "basic-select"})
			<div>
				<h3 class="font-medium mb-sm">Select Pill</h3>
				@components.SelectPill("text-xs", "YTD", "ytd", components.SelectPillLeft, []components.SelectOption{
					{Label: "YTD", Value: "ytd"},
					{Label: "6M", Value: "6m"},
					{Label: "1Y", Value: "1y"},
					{Label: "All", Value: "all"},
				}, templ.Attributes{"name": "basic-select"})
			</div>
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- DATE & TIME INPUTS                                             -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Date & Time Inputs
		</h2>
		<h3 class="font-medium mb-sm">Date Input — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.DateInput("", false, templ.Attributes{"placeholder": "dd/mm/yyyy", "id": "date-input-1"})
			</div>
			<div style="flex: 1;">
				@components.DateInput("", false, templ.Attributes{"placeholder": "dd/mm/yyyy", "id": "date-input-disabled", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Date Input with Error — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.DateInput("", true, templ.Attributes{"placeholder": "dd/mm/yyyy", "id": "date-input-error"})
			</div>
			<div style="flex: 1;">
				@components.DateInput("", true, templ.Attributes{"placeholder": "dd/mm/yyyy", "id": "date-input-error-disabled", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Date Input Group — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.DateInputGroup("", "Birth Date", "", false, true, templ.Attributes{"id": "date-group", "placeholder": "dd/mm/yyyy"})
			</div>
			<div style="flex: 1;">
				@components.DateInputGroup("", "Birth Date", "", false, true, templ.Attributes{"id": "date-group-disabled", "placeholder": "dd/mm/yyyy", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Date Input Group (optional) — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.DateInputGroup("", "End Date", "", false, false, templ.Attributes{"id": "date-group-opt", "placeholder": "dd/mm/yyyy"})
			</div>
			<div style="flex: 1;">
				@components.DateInputGroup("", "End Date", "", false, false, templ.Attributes{"id": "date-group-opt-disabled", "placeholder": "dd/mm/yyyy", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Time Input — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md mb-md">
			<div style="flex: 1;">
				@components.TimeInput("", false, templ.Attributes{"id": "time-input-1"})
			</div>
			<div style="flex: 1;">
				@components.TimeInput("", false, templ.Attributes{"id": "time-input-disabled", "disabled": ""})
			</div>
		</div>
		<h3 class="font-medium mb-sm">Time Input with Error — Enabled vs Disabled</h3>
		<div class="flex items-end gap-md">
			<div style="flex: 1;">
				@components.TimeInput("", true, templ.Attributes{"id": "time-input-error"})
			</div>
			<div style="flex: 1;">
				@components.TimeInput("", true, templ.Attributes{"id": "time-input-error-disabled", "disabled": ""})
			</div>
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- TOGGLE SWITCH                                                  -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Toggle Switch
		</h2>
		<div class="grid grid-cols-2 gap-md">
			<div>
				<h3 class="font-medium mb-sm">Toggle Switch (2 options)</h3>
				@components.ToggleSwitch("text-sm", "toggle-billing", []components.ToggleOption{
					{Label: "Monthly", Id: "monthly", Value: "monthly"},
					{Label: "Yearly", Id: "yearly", Value: "yearly", Checked: true},
				}, nil)
			</div>
			<div>
				<h3 class="font-medium mb-sm">Toggle Switch (3 options)</h3>
				@components.ToggleSwitch("text-xs", "toggle-period", []components.ToggleOption{
					{Label: "Day", Id: "day", Value: "day", Checked: true},
					{Label: "Week", Id: "week", Value: "week"},
					{Label: "Month", Id: "month", Value: "month"},
				}, nil)
			</div>
			<div>
				<h3 class="font-medium mb-sm">Toggle Switch Group</h3>
				@components.ToggleSwitchGroup("text-sm", "View Mode", "view-mode", []components.ToggleOption{
					{Label: "Table", Id: "table", Value: "table"},
					{Label: "Grid", Id: "grid", Value: "grid", Checked: true},
					{Label: "List", Id: "list", Value: "list"},
				}, nil)
			</div>
			<div>
				<h3 class="font-medium mb-sm">Toggle Switch Group (2 options)</h3>
				@components.ToggleSwitchGroup("text-xs", "Chart Type", "chart-type", []components.ToggleOption{
					{Label: "Bar", Id: "bar", Value: "bar", Checked: true},
					{Label: "Line", Id: "line", Value: "line"},
				}, nil)
			</div>
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- SLIDERS                                                        -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Sliders
		</h2>
		<div class="grid grid-cols-2 gap-md">
			<div>
				<h3 class="font-medium mb-sm">Single Slider (value: 25/100)</h3>
				@components.SliderInput(0, 100, 25, "single-slider", nil)
			</div>
			<div>
				<h3 class="font-medium mb-sm">Single Slider (value: 75/100)</h3>
				@components.SliderInput(0, 100, 75, "single-slider-2", nil)
			</div>
			<div>
				<h3 class="font-medium mb-sm">Double Slider (range: 20-50 / 0-150)</h3>
				@components.DoubleSliderInput(0, 150, 20, 50, "minamount", "maxamount", nil, nil)
			</div>
			<div>
				<h3 class="font-medium mb-sm">Double Slider (range: 30-90 / 0-200)</h3>
				@components.DoubleSliderInput(0, 200, 30, 90, "minprice", "maxprice", nil, nil)
			</div>
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- LOADERS & PROGRESS                                             -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Loaders & Progress
		</h2>
		<div class="grid grid-cols-2 gap-md">
			<div>
				<h3 class="font-medium mb-sm">Loader (3 bouncing dots)</h3>
				@components.Loader("", nil)
			</div>
			<div>
				<h3 class="font-medium mb-sm">Custom Loader with class</h3>
				@components.Loader("p-md", templ.Attributes{"style": "background: var(--color-surface); border-radius: var(--radius-md);"})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Spinner (various sizes)</h3>
				<div class="flex gap-md items-center">
					<div class="flex flex-col items-center gap-xs">
						@components.Spinner(16, "", "")
						<span class="text-xs">16</span>
					</div>
					<div class="flex flex-col items-center gap-xs">
						@components.Spinner(24, "", "")
						<span class="text-xs">24</span>
					</div>
					<div class="flex flex-col items-center gap-xs">
						@components.Spinner(32, "", "")
						<span class="text-xs">32</span>
					</div>
					<div class="flex flex-col items-center gap-xs">
						@components.Spinner(40, "", "")
						<span class="text-xs">40</span>
					</div>
				</div>
			</div>
			<div>
				<h3 class="font-medium mb-sm">Spinner (colored)</h3>
				<div class="flex gap-md items-center">
					@components.Spinner(24, "var(--color-primary)", "")
					@components.Spinner(24, "var(--color-success)", "")
					@components.Spinner(24, "var(--color-warning)", "")
					@components.Spinner(24, "var(--color-error)", "")
				</div>
			</div>
			<div class="col-span-2">
				<h3 class="font-medium mb-sm">Progress Bar</h3>
				<div class="flex flex-col gap-sm" style="max-width: 400px;">
					<div class="flex items-center gap-sm">
						<span class="text-sm w-fit" style="min-width: 3rem;">25%</span>
						@components.ProgressBar("", 25)
					</div>
					<div class="flex items-center gap-sm">
						<span class="text-sm w-fit" style="min-width: 3rem;">50%</span>
						@components.ProgressBar("", 50)
					</div>
					<div class="flex items-center gap-sm">
						<span class="text-sm w-fit" style="min-width: 3rem;">75%</span>
						@components.ProgressBar("", 75)
					</div>
					<div class="flex items-center gap-sm">
						<span class="text-sm w-fit" style="min-width: 3rem;">100%</span>
						@components.ProgressBar("", 100)
					</div>
					<div class="flex items-center gap-sm">
						<span class="text-sm w-fit" style="min-width: 3rem;">150%</span>
						@components.ProgressBar("", 150)
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- CALENDAR                                                       -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Calendar
		</h2>
		<div class="grid grid-cols-2 gap-md">
			<div>
				<h3 class="font-medium mb-sm">Pre-rendered Calendar</h3>
				@components.CalendarPreRendered()
			</div>
			<div>
				<h3 class="font-medium mb-sm">Empty Calendar (JS-populated)</h3>
				@components.Calendar()
			</div>
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- BREADCRUMBS                                                    -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Breadcrumbs
		</h2>
		<div class="flex flex-col gap-md">
			<div>
				<h3 class="font-medium mb-sm">Simple Breadcrumbs</h3>
				@components.Breadcrumbs(views.BreadcrumbsView{
					Items: []views.BreadcrumbsLink{
						{Href: "/", Name: "Home"},
						{Href: "/banks", Name: "Banks"},
						{Name: "Current Account"},
					},
				})
			</div>
			<div>
				<h3 class="font-medium mb-sm">Breadcrumbs with Dropdown</h3>
				@components.Breadcrumbs(views.BreadcrumbsView{
					Items: []views.BreadcrumbsLink{
						{Href: "/", Name: "Home"},
						{Href: "/budget", Name: "Budget"},
						{Name: "Select month..."},
					},
					Options: []views.BreadcrumbsLink{
						{Href: "/budget?month=012024", Name: "January 2024"},
						{Href: "/budget?month=022024", Name: "February 2024"},
						{Href: "/budget?month=032024", Name: "March 2024"},
					},
				})
			</div>
		</div>
	</section>
