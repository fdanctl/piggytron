		<div class="flex flex-col gap-md">
			<div>
				<h3 class="font-medium mb-sm">Month Navigation Pill</h3>
				@components.MonthPill("", "Select month", time.Now())
			</div>
		</div>
	</section>
	<!-- ============================================================ -->
	<!-- FILTER BUTTON                                                  -->
	<!-- ============================================================ -->
	<section class="mb-xl">
		<h2 class="text-xl font-semibold mb-md" style="border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
			Filter Button
		</h2>
		<div class="flex gap-md items-center">
			<div class="flex flex-col items-center gap-xs">
				<span class="text-xs text-muted">No filters</span>
				@components.FilterBtn(0, 0, "", "", nil)
			</div>
			<div class="flex flex-col items-center gap-xs">
				<span class="text-xs text-muted">3 active</span>
				@components.FilterBtn(3, 0, "", "", nil)
			</div>
			<div class="flex flex-col items-center gap-xs">
				<span class="text-xs text-muted">7 active</span>
				@components.FilterBtn(7, 0, "", "", nil)
			</div>
			<div class="flex flex-col items-center gap-xs">
				<span class="text-xs text-muted">Custom size/color</span>
				@components.FilterBtn(5, 32, "var(--color-error)", "", nil)
			</div>
		</div>
	</section>
