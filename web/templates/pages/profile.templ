package pages

import (
	"fmt"
	"github.com/fdanctl/piggytron/web/templates/components"
	"github.com/fdanctl/piggytron/web/views"
)

templ Profile(
	bview views.BreadcrumbsView,
	profileForm views.ProfileForm,
	changePasswordForm views.ChangePasswordForm,
) {
	<style>
		.card.mt-lg .input-group {
			flex: 1;
		}

		.avatar__overlay {
			position: absolute;
			background-color: oklch(from var(--color-neutral-primary) l c h / 40%);
			backdrop-filter: blur(1px);
			top: 0;
			left: 0;
			border-radius: var(--radius-full);
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--color-on-neutral-primary);
			opacity: 0;
			transition: opacity 200ms;
			cursor: pointer;
		}

		.avatar__with-overlay {
			position: relative;

			&:hover .avatar__overlay {
				opacity: 1;
			}
		}
	</style>
	@components.Breadcrumbs(bview)
	<div class="card">
		<h6 class="card__title">Profile Information</h6>
		<div class="flex gap-md">
			<div class="flex flex-col items-center gap-xs">
				<div class="avatar__with-overlay">
					@components.Avatar("", "", components.XXL)
					<div class={ "avatar__overlay", fmt.Sprintf("size-%d", components.SizeMap[components.XXL]) } data-action="ui.element.click" data-target="find input[type='file']">
						@components.CameraSvg(30, "", "")
						<input
							id="upload"
							name="pfp"
							type="file"
							accept="image/*"
							hx-get="partials/user/edit-pfp"
							hx-swap="outerHTML"
							hx-target="closest .avatar__with-overlay img"
							hidden
						/>
					</div>
				</div>
				@components.Button("Edit photo", "mt-xs", components.BtnOutline, components.BtnSmall, templ.Attributes{"type": "submit", "data-action": "ui.element.click", "data-target": "#upload"})
			</div>
			<form style="flex: 1">
				@components.InputGroup(
					"",
					"Name",
					views.StringArrToStr(profileForm.ValidateName()),
					profileForm.NameHasError(),
					true,
					templ.Attributes{"id": "name",
						"type":        "text",
						"name":        "name",
						"placeholder": "Name",
						"value":       profileForm.Name,
					})
				<div class="flex justify-end mt-lg">
					@components.Button("Save profile", "", components.BtnPrimary, components.BtnMedium, templ.Attributes{"type": "submit"})
				</div>
			</form>
		</div>
	</div>
	<form class="card mt-lg">
		<h6 class="card__title">Change Password</h6>
		<div class="flex w-full gap-sm">
			@components.InputGroup(
				"",
				"Current Password",
				views.StringArrToStr(changePasswordForm.ValidateCurrentPassword()),
				changePasswordForm.CurrentPasswordHasError(),
				true,
				templ.Attributes{
					"id":    "current-password",
					"type":  "password",
					"name":  "current-password",
					"value": changePasswordForm.CurrentPassword,
				},
			)
			@components.InputGroup(
				"",
				"New Password",
				"",
				changePasswordForm.NewPasswordHasError(),
				true,
				templ.Attributes{
					"id":    "new-password",
					"type":  "password",
					"name":  "new-password",
					"value": changePasswordForm.NewPassword,
				},
			)
			@components.InputGroup(
				"",
				"Confirm New Password",
				views.StringArrToStr(changePasswordForm.ValidateNewPassword()),
				changePasswordForm.NewPasswordHasError(),
				true,
				templ.Attributes{
					"id":    "new-password-confirm",
					"type":  "password",
					"name":  "new-password-confirm",
					"value": changePasswordForm.NewPasswordConfirm,
				},
			)
		</div>
		<div class="flex justify-end mt-lg">
			@components.Button("Update password", "", components.BtnPrimary, components.BtnMedium, templ.Attributes{"type": "submit"})
		</div>
	</form>
}
